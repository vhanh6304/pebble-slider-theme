{%- assign tpl =  template | replace: '.', ' ' | truncatewords: 1, '' | handle  -%}
		 	 
		 		{%- if   tpl != 'product' and product == blank-%}
		 			{% assign product  =  collections['all'].products.first  %}
		 		{%- endif -%}<div class="lh-wrapper lh-section-rating">
  <div class="lh-container">
    <div class="lh-form-rating">{% render 'layouthub_review',  review_type: 'form' , product: product %}</div>
  </div>
</div>
 
  </section><section id="" data-section-id="g4mCAFfp2r" data-section="product-related-9" data-dev="huynh-duc" data-lh-page-id="760" data-lh-page-name="Brook - Product Detail" data-layouthub="section">  
  





<div class="lh-collection-slide" data-money-format="{{shop.money_format | url_encode }}" data-col="lh-col-md-3" data-hub-attr-state="class%3D%22lh-collection-slide%22%20data-money-format%3D%22%7B%3A%7Bsection.liquid.money_format%7D%3A%7D%22%20data-col%3D%22%257B%253A%257Bsection.settings.item%257D%253A%257D%22"  data-hub-attr-item >

	<div class="lh-collection-wrapper">

		<div class="lh-container">

			<div class="lh-row">

      	<div class="lh-product-content lh-col-md-12">

				<include data-live-title data-live-des data-live-name_product data-live-show_badge data-live-show_2 data-live-image_size data-live-trans_soldout_text data-live-unavailable_text data-name="content" data-id="1">  
 <div class="">
  <div class="lh-collection-heading">
    <div class="lh-collection-heading__text">
      <div class="lh-collection-heading__title"><h4  data-lhi="title" data-lh-lang>{{'g4mCAFfp2r.title' | t }}</h4></div>
      <div class="lh-collection-heading__des"><p  data-lhi="des" data-lh-lang data-lh-live-editor></p></div>
    </div>
  </div>
</div>
<div class="">
  <div class="js-product-list lh-product-related lh-row ellipsis lh-badge-yes " data-product_id="{{- product.id -}}" data-hub-attr-state="class%3D%22js-product-list%20lh-product-related%20lh-row%20%257B%253A%257Bsection.settings.name_product%257D%253A%257D%20lh-badge-%257B%253A%257Bsection.settings.show_badge%257D%253A%257D%20%7Battr%7Bsection.settings.show_2%20%3D%3D%20'yes'%20%3F%20'lh-two-col'%3A''%7Dattr%7D%22%20data-product_id%3D%22%7B%3A%7Bsection.liquid.product_id%7D%3A%7D%22"  data-hub-attr-name_product  data-hub-attr-show_badge >
    {% assign arr_product = collections['all'].products %}
					 
					{% assign text_handle_temp = "" %}
					{%- for p in arr_product -%}
						{% assign text_handle_temp = text_handle_temp | append: "," | append : p.handle %}
					{%- endfor -%}
					{% assign limit = 10 %}
					{% assign count = 1 %}
					{% if product and template contains 'product' %}
						{% assign text_handle = "" %}
						{%- if product.collections.size > 0 -%}
								{%- for item_c in product.collections -%}
									{%- for item_p in item_c.products -%}
										{%- if count <= limit -%}
											{%- if item_p.handle != product.handle -%}
												{% assign count = count | plus : 1 %}
												{% assign text_handle = text_handle | append: "," | append: item_p.handle %}
											{%- endif -%}
										{%- endif -%}
									{%- endfor -%}
								{%- endfor -%}
						{%- endif -%}
						{%- if count < limit -%}
							{% assign p_realted = collections['all'].products | where: "vendor", product.vendor | where: "type", product.type %}
							{%- for item_p in p_realted -%}
								{%- if count <= limit -%}
									{%- if item_p.handle != product.handle -%}
										{% assign count = count | plus : 1 %}
										{% assign text_handle = text_handle | append: "," | append: item_p.handle %}
									{%- endif -%}
								{%- endif -%}
							{%- endfor -%}
						{%- endif -%}
					{% endif %}
					{%- if text_handle != blank -%}
						{% assign arr_handle = text_handle | split: "," %}
					{%- else -%}
						{% assign arr_handle = text_handle_temp | split: "," %}
					{%- endif -%}
					{% assign arr_handle = arr_handle | uniq %}
					{% assign limit = limit | plus : 1 %}
					{% for item in arr_handle limit:limit %}
						{%- if item == blank -%}
							{%- continue -%}
						{%- endif -%}
						{% assign i_product = all_products[item] %}
						{% assign first_variant = i_product.selected_or_first_available_variant %}
						{% assign v_type = '' %}
						{% assign isSale = false %}
						{%- if first_variant.available -%}
							{%- if first_variant.compare_at_price > first_variant.price -%}
								{% assign isSale = true %}
								{% assign v_type = 'sale' %}
							{%- endif -%}
						{%- else -%}
							{% assign v_type = 'soldout' %}
						{%- endif -%}
						<div class="lh-collection-item" data-v-type="{{v_type}}">
							<div class="lh-collection-thumb">
								<a href="{{i_product.url | within: collection}}">
									 
										<img src="{{i_product.featured_image | img_url : '540x540_crop_center'}}" alt="{{i_product.title}}">
										{% if i_product.images.size > 1 %}
											<img src="{{i_product.images[1] | img_url : '540x540_crop_center'}}" class="hover-image" alt="{{i_product.title}}">
										{% else %}
											<img src="{{i_product.featured_image | img_url : '540x540_crop_center'}}" class="hover-image" alt="{{i_product.title}}">
										{% endif %}
									 
								</a>
								<div class="lh-product-badges">
									{% if v_type == 'soldout' %}
										<p class="lh-sold-out"  data-lhi="trans_soldout_text" data-lh-lang>{{'g4mCAFfp2r.lh_rivarn_text' | t }}</p>
									{% else %}
										<p class="lh-sold-out"  data-lhi="unavailable_text" data-lh-lang>{{'g4mCAFfp2r.lh_64ra6o_text' | t }}</p>
									{% endif %}
									<p class="lh-onsale">
										<text  data-lhi="trans_sale_text" data-lh-lang>{{'g4mCAFfp2r.lh_k4izmq_text' | t }}</text> <span>{% if isSale %}{{ 1.00 | plus: first_variant.compare_at_price | minus: first_variant.price | times: 100 | divided_by: first_variant.compare_at_price | round }} % {% else %} 0% {% endif %}</span>
									</p>
									{%- for tag in i_product.tags -%}
										{%- if tag == 'new' -%}
											<p class="lh-hot"  data-lhi="trans_new_text" data-lh-lang>{{'g4mCAFfp2r.lh_rv7qtl_text' | t }}</p>
											{%- break -%}
										{%- endif -%}
									{%- endfor -%}
								</div>
							</div>
							<div class="lh-collection-info">
									<div class="lh-title-wrap ">
										<h3 class="lh-product-title">
											<a href="{{i_product.url | within: collection}}">{{i_product.title}}</a>
										</h3>
									</div>
									<div class="lh-price">
										{% if first_variant.compare_at_price > first_variant.price %}
										<del class="lh-product-compare-price">{{first_variant.compare_at_price | money}}</del>
										{% endif %}
										<ins class="lh-product-price">{{first_variant.price | money}}</ins>
									</div>
									 
									<div class="lh-wrap-rating">
										{% render 'layouthub_review',  review_type: 'rating', product: i_product %}
									</div>
									 
									 
										<form class="lh-product-swatch" action="/cart/add" method="get" id="lh-form-swatch-{{i_product.id }}" target="_blank">
											<input type="hidden" name="id" value="{{i_product.selected_or_first_available_variant.id}}">
											<input type="hidden" name="quantity" value="1">
											{% if i_product.variants.size > 1 %}
												<div class="lh-block_variants" id="lh-product-select-{{ i_product.id }}">
													{% for product_option in i_product.options_with_values %}
														{% assign style_variant = 'tag' %}
														{% assign isImage = "no" %}
														{% assign showValue = "no" %}
														 
															{% assign option_name = product_option.name | downcase %}
															{% assign swatch_name = 'color' %}
															{%- if option_name == 'color' -%}
																{% assign isImage = 'yes' %}
																{% assign showValue = 'no' %}
																{% assign style_variant = 'circle' %}
																{%- if style_variant == 'circle' or style_variant == 'square' -%}
																	{% assign option_index = 'option' | append: forloop.index %}
																{%- endif -%}
															{%- endif -%}
														 
															{% assign option_name = product_option.name | downcase %}
															{% assign swatch_name = 'size' %}
															{%- if option_name == 'size' -%}
																{% assign isImage = '' %}
																{% assign showValue = '' %}
																{% assign style_variant = 'tag' %}
																{%- if style_variant == 'circle' or style_variant == 'square' -%}
																	{% assign option_index = 'option' | append: forloop.index %}
																{%- endif -%}
															{%- endif -%}
														 
															{% assign option_name = product_option.name | downcase %}
															{% assign swatch_name = 'material' %}
															{%- if option_name == 'material' -%}
																{% assign isImage = '' %}
																{% assign showValue = '' %}
																{% assign style_variant = 'tag' %}
																{%- if style_variant == 'circle' or style_variant == 'square' -%}
																	{% assign option_index = 'option' | append: forloop.index %}
																{%- endif -%}
															{%- endif -%}
														 
														{%- if product_option.name != 'Title' -%}
																<div class="lh-block-variants">
																	<div class="lh-items-variants">
																	<ul class="lh-content__variants_list" data-variant="{{product_option.name}}" data-target="lh-product-select-{{ i_product.id }}-option-{{forloop.index0}}" data-style={{style_variant}} data-use-image="{{isImage}}" data-option-index="{{forloop.index0}}">
																	{% for value in product_option.values %}
																		<li class="lh-swatch-on-grid {% if product_option.selected_value == value %}active{% endif %}">
																			{% assign lh_bg = '#dddddd' %}
																			{% assign is_color_image = '' %}
																			<!-- SET BACKGROUND SWATCH TYPE COLOR -->
																			{%- if style_variant == 'circle' or style_variant == "square" -%}
																				{%- if isImage == 'no' -%}
																					{% assign value_down = value | downcase %}
																					{%- if color_names_downcase contains value_down -%}
																						{% assign is_color_image = 'lh-color-image' %}
																						{%- for color in color_names_downcase %}
																							{%- assign lh_bg =  color_values[forloop.index0] -%}
																							{%- if color == value_down -%}
																								{%- break -%}
																							{%- endif -%}
																						{%- endfor -%}
																					{%- endif -%}
																				<!-- SET BACKGROUND SWATCH TYPE IMAGE -->
																				{%- elsif isImage == 'yes' -%}
																					{%- for var in i_product.variants -%}
																						{%- if var[option_index] == value -%}
																							{% assign is_color_image = 'lh-color-image' %}
																								{%- if var.featured_image != null -%}
																									{% assign lh_image = var | img_url: "120x120", crop: 'center' %}
																									{% assign lh_bg = 'url(' | append: lh_image | append: ') center center/cover no-repeat' %}
																									{%- break -%}
																								{%- endif -%}
																						{%- endif -%}
																					{%- endfor -%}
																				{%- endif -%}
																			{%- endif -%}
																			{% assign use_bg = false %}
																			{%- if style_variant == 'circle' or style_variant == 'square' -%}
																				{% assign use_bg = true %}
																			{%- endif -%}
																			<span class="lh-swatch {{is_color_image}}" data-value="{{value}}" title="{{value}}">

																				{%- if use_bg  -%}
																					<span class="lh-swatch-bg" style="background : {{lh_bg}}">

																					</span>
																					{%- if showValue == "yes" -%}
																						<span class="lh-swatch-title">{{ value }}</span>
																					{%- endif -%}
																				{%- else  -%}
																					<span class="lh-swatch-title">{{ value }}</span>
																				{%- endif -%}
																			</span>
																		</li>
																	{% endfor %}
																	</ul>
																</div>
																</div>
														{%- endif -%}
													{% endfor %}
												</div>
											{% endif %}
											<script id="lh-swatch-json-{{i_product.id}}" type="application/json">
											{%- if true -%}
													{
													"id": {{i_product.id}},
													"title": {{i_product.title | json}},
													"handle": {{i_product.handle | json}},
													"price": {{i_product.price| json}},
													"price_min": {{i_product.price_min| json}},
													"price_max": {{i_product.price_max| json}},
													"available": {{i_product.available | json}},
													"price_varies": {{i_product.price_varies| json}},
													"compare_at_price": {{i_product.compare_at_price| json}},
													"compare_at_price_min": {{i_product.compare_at_price_min| json}},
													"compare_at_price_max": {{i_product.compare_at_price_max| json}},
													"compare_at_price_varies": {{i_product.compare_at_price_varies| json}},
													"variants":  {{i_product.variants  | json}},
													"featured_image": {{i_product.featured_image | json}},
													"options": [
													{%- for option in i_product.options -%}
													{{ option | json}}{%- if forloop.last == false -%},{%- endif -%}
													{%-endfor -%}
													]
													}
													{%- endif -%}
									 			</script>
										</form>
									 
							</div>
						</div>
					{% endfor %}</div>
