{{ 'helix-inspired-header.css' | asset_url | stylesheet_tag }}
{{ 'helix-inspired-header-overlay.css' | asset_url | stylesheet_tag }}
{{ 'helix-inspired-header-fixes.css' | asset_url | stylesheet_tag }}
<script src="{{ 'helix-inspired-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign menu_blocks = section.blocks | where: 'type', 'mega_menu'
  assign page_blocks = section.blocks | where: 'type', 'page_link'
  assign announcement_blocks = section.blocks | where: 'type', 'announcement'
  assign header_logo = section.settings.logo
-%}

<header
  class="lhx-header full-width{% if request.page_type == 'index' and section.settings.overlay_on_home %} lhx-header--overlay{% endif %}"
  data-lhx-header
  data-announcement-delay="{{ section.settings.announcement_delay | times: 1000 }}"
  data-announcement-autoplay="{{ section.settings.enable_announcement_autoplay }}"
  data-sticky="{{ section.settings.enable_sticky }}"
  data-section-id="{{ section.id }}"
  data-root-url="{{ routes.root_url }}"
  data-cart-url="{{ routes.cart_url }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-cart-change-url="{{ routes.cart_change_url }}"
  data-all-products-url="{{ routes.all_products_collection_url }}"
  data-search-url="{{ routes.search_url }}"
  data-search-suggest-url="{{ routes.predictive_search_url }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
>
  {%- if section.settings.show_announcement and announcement_blocks.size > 0 -%}
    <aside class="lhx-announcement" aria-label="Store announcements">
      <div class="lhx-announcement__track" data-announcement-track aria-live="polite" aria-atomic="true">
        {%- for block in announcement_blocks -%}
          <p class="lhx-announcement__item{% if forloop.first %} is-active{% endif %}" data-announcement-item {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
              {{ block.settings.text | escape }}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </p>
        {%- endfor -%}
      </div>
      {%- if announcement_blocks.size > 1 -%}
        <div class="lhx-announcement__controls">
          <button class="lhx-icon-button lhx-announcement__button" type="button" data-announcement-prev aria-label="Previous announcement">{% render 'lhx-icon', icon: 'chevron-left' %}</button>
          <button class="lhx-icon-button lhx-announcement__button" type="button" data-announcement-next aria-label="Next announcement">{% render 'lhx-icon', icon: 'chevron-right' %}</button>
        </div>
      {%- endif -%}
    </aside>
  {%- endif -%}

  <div class="lhx-header__shell" data-header-shell>
    <div class="lhx-header__bar">
      <button class="lhx-icon-button lhx-mobile-only" type="button" data-drawer-open="menu" aria-label="Open menu" aria-expanded="false" aria-controls="lhx-menu-{{ section.id }}">{% render 'lhx-icon', icon: 'menu' %}</button>

      <nav class="lhx-nav lhx-desktop-only" aria-label="Main navigation">
        {%- for block in menu_blocks limit: 2 -%}
          {%- assign block_collection = block.settings.collection -%}
          <button class="lhx-nav__trigger" type="button" data-mega-trigger="{{ block.id }}" aria-expanded="false" aria-controls="lhx-mega-{{ block.id }}" {{ block.shopify_attributes }}>
            <span>{{ block.settings.label | escape }}</span>{% render 'lhx-icon', icon: 'chevron-down' %}
          </button>
        {%- endfor -%}
        <button class="lhx-nav__trigger" type="button" data-pages-trigger aria-expanded="false" aria-controls="lhx-pages-menu">
          <span>{{ section.settings.pages_label | escape }}</span>{% render 'lhx-icon', icon: 'chevron-down' %}
        </button>
        {%- if section.settings.find_link_label != blank -%}
          <a class="lhx-nav__link" href="{{ section.settings.find_link | default: routes.root_url }}">{{ section.settings.find_link_label | escape }}</a>
        {%- endif -%}
      </nav>

      <a class="lhx-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
        {%- if header_logo != blank -%}
          {{ header_logo | image_url: width: 300 | image_tag: class: 'lhx-logo__image', widths: '120,180,240,300', alt: shop.name }}
        {%- else -%}
          <span>{{ shop.name | escape }}</span>
        {%- endif -%}
      </a>

      <div class="lhx-actions">
        {%- if section.settings.show_localization -%}
          <button class="lhx-localization lhx-desktop-only" type="button" data-drawer-open="localization" aria-label="Choose country or language" aria-expanded="false" aria-controls="lhx-localization-{{ section.id }}">
            {{ localization.country.iso_code }} / {{ localization.language.iso_code | upcase }}
          </button>
        {%- endif -%}
        <button class="lhx-icon-button" type="button" data-drawer-open="search" aria-label="Search" aria-expanded="false" aria-controls="lhx-search-drawer-{{ section.id }}">{% render 'lhx-icon', icon: 'search' %}</button>
        <a class="lhx-icon-button lhx-desktop-only" href="{{ routes.account_url }}" aria-label="Account">{% render 'lhx-icon', icon: 'account' %}</a>
        <button class="lhx-icon-button lhx-cart-button" type="button" data-drawer-open="cart" aria-label="Cart" aria-expanded="false" aria-controls="lhx-cart-{{ section.id }}">
          {% render 'lhx-icon', icon: 'bag' %}<span class="lhx-cart-count" data-cart-count{% if cart.item_count == 0 %} data-empty="true"{% endif %}>{{ cart.item_count }}</span>
        </button>
      </div>
    </div>

    <div class="lhx-pages-menu lhx-desktop-only" id="lhx-pages-menu" data-pages-menu role="menu" hidden>
      {%- for block in page_blocks -%}
        {%- if block.settings.page != blank -%}
          <a href="{{ block.settings.page.url }}" role="menuitem" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.page.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="lhx-mega-surface lhx-desktop-only" data-mega-surface aria-hidden="true"></div>

  {%- for block in menu_blocks limit: 2 -%}
    {%- liquid
      assign featured_collection = block.settings.featured_collection | default: block.settings.collection
      assign desktop_content_style = 'product_rail'
      if forloop.first
        assign desktop_content_style = 'promo_banners'
      endif
      assign primary_url = block.settings.collection.url | default: routes.all_products_collection_url
      assign on_sale_url = block.settings.mobile_on_sale_link
      if on_sale_url == blank
        assign on_sale_url = routes.search_url | append: '?q=sale&type=product'
      endif
      assign promo_product_one = featured_collection.products.first
      assign promo_product_two = featured_collection.products[1] | default: promo_product_one
      assign promo_image_one = block.settings.promo_image_1 | default: promo_product_one.featured_image | default: block.settings.collection.image
      assign promo_image_two = block.settings.promo_image_2 | default: promo_product_two.featured_image | default: block.settings.secondary_collection.image
      assign promo_link_one = block.settings.promo_link_1 | default: primary_url
      assign promo_link_two = block.settings.promo_link_2 | default: block.settings.secondary_collection.url | default: primary_url
    -%}
    <section class="lhx-mega lhx-desktop-only" id="lhx-mega-{{ block.id }}" data-mega-panel="{{ block.id }}" hidden aria-label="{{ block.settings.label | escape }} menu">
      <div class="lhx-mega__inner lhx-mega__inner--{{ desktop_content_style }}">
        <div class="lhx-mega__menu-grid">
          <div class="lhx-mega__column lhx-mega__column--primary">
            <ul class="lhx-mega__primary-list">
              {%- if block.settings.menu != blank -%}
                {%- for link in block.settings.menu.links limit: 5 -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
              {%- else -%}
                <li><a href="{{ primary_url }}">Top picks</a></li>
                <li><a href="{{ primary_url }}?sort_by=best-selling">Best sellers</a></li>
                <li><a href="{{ primary_url }}">Trending</a></li>
                <li><a href="{{ primary_url }}?sort_by=created-descending">New arrivals</a></li>
                <li><a href="{{ on_sale_url }}">On sale</a></li>
              {%- endif -%}
            </ul>
          </div>
          <div class="lhx-mega__column">
            <p class="lhx-mega__column-title">{{ block.settings.secondary_title | default: 'By activity' | escape }}</p>
            <ul>
              {%- if block.settings.secondary_menu != blank -%}
                {%- for link in block.settings.secondary_menu.links limit: 6 -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
              {%- else -%}
                <li><a href="{{ primary_url }}">Hiking</a></li>
                <li><a href="{{ primary_url }}">Running</a></li>
                <li><a href="{{ primary_url }}">Training</a></li>
                <li><a href="{{ primary_url }}">Tennis</a></li>
                <li><a href="{{ primary_url }}">Lifestyle</a></li>
                <li><a href="{{ primary_url }}">Shop all</a></li>
              {%- endif -%}
            </ul>
          </div>
          <div class="lhx-mega__column">
            <p class="lhx-mega__column-title">{{ block.settings.feature_title | default: 'By feature' | escape }}</p>
            <ul>
              {%- if block.settings.feature_menu != blank -%}
                {%- for link in block.settings.feature_menu.links limit: 5 -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
              {%- else -%}
                <li><a href="{{ primary_url }}">Cushioned</a></li>
                <li><a href="{{ primary_url }}">Waterproof</a></li>
                <li><a href="{{ primary_url }}">Water-resistant</a></li>
                <li><a href="{{ primary_url }}">Breathable</a></li>
                <li><a href="{{ primary_url }}">Windproof</a></li>
              {%- endif -%}
            </ul>
          </div>
        </div>

        {%- if desktop_content_style == 'promo_banners' -%}
          <div class="lhx-mega__banners">
            <article class="lhx-mega-banner">
              <a class="lhx-mega-banner__image" href="{{ promo_link_one }}" aria-label="{{ block.settings.promo_title_1 | default: 'Women’s sale' | escape }}">
                {%- if promo_image_one != blank -%}
                  {{ promo_image_one | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320,480,640,900', sizes: '(min-width: 991px) 24vw, 50vw', alt: block.settings.promo_title_1 }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'lhx-mega-banner__placeholder' }}
                {%- endif -%}
              </a>
              <h3><a href="{{ promo_link_one }}">{{ block.settings.promo_title_1 | default: 'Women’s sale' | escape }}</a></h3>
              <a class="lhx-mega-banner__cta" href="{{ promo_link_one }}">{{ block.settings.promo_button_label | default: 'Shop now' | escape }} <span aria-hidden="true">↗</span></a>
            </article>
            <article class="lhx-mega-banner">
              <a class="lhx-mega-banner__image" href="{{ promo_link_two }}" aria-label="{{ block.settings.promo_title_2 | default: 'Women’s favorites' | escape }}">
                {%- if promo_image_two != blank -%}
                  {{ promo_image_two | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320,480,640,900', sizes: '(min-width: 991px) 24vw, 50vw', alt: block.settings.promo_title_2 }}
                {%- else -%}
                  {{ 'collection-2' | placeholder_svg_tag: 'lhx-mega-banner__placeholder' }}
                {%- endif -%}
              </a>
              <h3><a href="{{ promo_link_two }}">{{ block.settings.promo_title_2 | default: 'Women’s favorites' | escape }}</a></h3>
              <a class="lhx-mega-banner__cta" href="{{ promo_link_two }}">{{ block.settings.promo_button_label | default: 'Shop now' | escape }} <span aria-hidden="true">↗</span></a>
            </article>
          </div>
        {%- else -%}
          <div class="lhx-mega__products lhx-mega__deals" data-product-rail>
            <div class="lhx-mega__deals-header">
              <h3>{{ block.settings.desktop_products_heading | default: 'Best deals 🔥' | escape }}</h3>
              <div class="lhx-rail-controls">
                <button class="lhx-icon-button" type="button" data-rail-prev aria-label="Previous products" disabled>{% render 'lhx-icon', icon: 'chevron-left' %}</button>
                <button class="lhx-icon-button" type="button" data-rail-next aria-label="Next products">{% render 'lhx-icon', icon: 'chevron-right' %}</button>
              </div>
            </div>
            <div class="lhx-mega__rail" data-product-rail-track>
              {%- for product in featured_collection.products limit: 6 -%}
                {%- liquid
                  assign variant = product.selected_or_first_available_variant
                  assign compare_price = variant.compare_at_price
                  assign sale_percent = 0
                  if compare_price > variant.price
                    assign sale_saving = compare_price | minus: variant.price
                    assign sale_percent = sale_saving | times: 100.0 | divided_by: compare_price | round
                  endif
                -%}
                <article class="lhx-product-card">
                  <div class="lhx-product-card__visual">
                    <a href="{{ product.url }}" class="lhx-product-card__image">
                      {%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 620 | image_tag: loading: 'lazy', widths: '220,320,420,520,620', alt: product.title }}{%- endif -%}
                    </a>
                    {%- if sale_percent > 0 -%}<span class="lhx-product-card__badge">-{{ sale_percent }}%</span>{%- endif -%}
                    {%- if variant != blank and variant.available -%}
                      <button type="button" class="lhx-product-card__add" data-quick-add data-quick-add-icon data-variant-id="{{ variant.id }}" data-product-title="{{ product.title | escape }}" aria-label="Quick add {{ product.title | escape }}">{% render 'lhx-icon', icon: 'bag' %}</button>
                    {%- endif -%}
                  </div>
                  {%- if product.images.size > 1 -%}
                    <div class="lhx-product-card__thumbs" aria-hidden="true">
                      {%- for image in product.images limit: 2 -%}
                        <span>{{ image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,90,120', alt: '' }}</span>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                  <div class="lhx-product-card__meta">
                    <a href="{{ product.url }}">{{ product.title | escape }}</a>
                    <div class="lhx-product-card__prices">
                      <span{% if sale_percent > 0 %} class="is-sale"{% endif %}>{{ variant.price | money }}</span>
                      {%- if sale_percent > 0 -%}<s>{{ compare_price | money }}</s>{%- endif -%}
                    </div>
                  </div>
                </article>
              {%- else -%}
                <p class="lhx-mega__empty">Choose a featured collection in Theme Editor.</p>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endfor -%}

  <div class="lhx-backdrop" data-header-backdrop aria-hidden="true" hidden></div>

  <aside class="lhx-drawer lhx-drawer--left" id="lhx-menu-{{ section.id }}" data-drawer="menu" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true" tabindex="-1" hidden>
    <div class="lhx-drawer__header"><a class="lhx-drawer__brand" href="{{ routes.root_url }}">{%- if header_logo != blank -%}{{ header_logo | image_url: width: 240 | image_tag: widths: '120,180,240', alt: shop.name }}{%- else -%}{{ shop.name | escape }}{%- endif -%}</a><button class="lhx-icon-button" type="button" data-drawer-close aria-label="Close menu">{% render 'lhx-icon', icon: 'close' %}</button></div>
    <div class="lhx-mobile-panel is-active" data-mobile-panel="root">
      <nav class="lhx-mobile-nav" aria-label="Mobile navigation">
        {%- for block in menu_blocks limit: 2 -%}
          <div class="lhx-mobile-nav__item lhx-mobile-nav__item--split">
            <a href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}">{{ block.settings.label | escape }}</a>
            <button type="button" data-mobile-panel-open="{{ block.id }}" aria-controls="lhx-mobile-panel-{{ block.id }}" aria-expanded="false" aria-label="Explore {{ block.settings.label | escape }}">{% render 'lhx-icon', icon: 'arrow-right' %}</button>
          </div>
        {%- endfor -%}
        <div class="lhx-mobile-nav__item"><a href="{{ section.settings.find_link | default: routes.root_url }}">{{ section.settings.find_link_label | escape }}</a></div>
        <div class="lhx-mobile-nav__item lhx-mobile-nav__item--toggle"><button type="button" data-mobile-panel-open="pages" aria-controls="lhx-mobile-panel-pages-{{ section.id }}" aria-expanded="false">{{ section.settings.pages_label | escape }}{% render 'lhx-icon', icon: 'arrow-right' %}</button></div>
      </nav>
      <a class="lhx-mobile-account" href="{{ routes.account_url }}">{% render 'lhx-icon', icon: 'account' %} Account</a>
      {%- if section.settings.show_localization -%}<button class="lhx-mobile-localization" type="button" data-drawer-switch="localization">{{ localization.country.name }} · {{ localization.language.endonym_name }}</button>{%- endif -%}
      {%- if section.settings.social_facebook != blank or section.settings.social_instagram != blank or section.settings.social_youtube != blank or section.settings.social_tiktok != blank -%}
        <div class="lhx-mobile-social" aria-label="Social media">
          {%- if section.settings.social_facebook != blank -%}<a href="{{ section.settings.social_facebook }}" aria-label="Facebook">Fb</a>{%- endif -%}
          {%- if section.settings.social_instagram != blank -%}<a href="{{ section.settings.social_instagram }}" aria-label="Instagram">Ig</a>{%- endif -%}
          {%- if section.settings.social_youtube != blank -%}<a href="{{ section.settings.social_youtube }}" aria-label="YouTube">Yt</a>{%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}<a href="{{ section.settings.social_tiktok }}" aria-label="TikTok">Tk</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- for block in menu_blocks limit: 2 -%}
      {%- assign mobile_featured_collection = block.settings.featured_collection | default: block.settings.collection -%}
      {%- assign mobile_navigation = block.settings.mobile_menu -%}
      {%- assign mobile_primary_url = block.settings.collection.url | default: routes.all_products_collection_url -%}
      {%- assign mobile_featured_url = mobile_featured_collection.url | default: mobile_primary_url -%}
      {%- assign mobile_on_sale_url = block.settings.mobile_on_sale_link -%}
      {%- if mobile_on_sale_url == blank -%}
        {%- assign mobile_on_sale_url = routes.search_url | append: '?q=sale&type=product' -%}
      {%- endif -%}
      <section class="lhx-mobile-subpanel" id="lhx-mobile-panel-{{ block.id }}" data-mobile-subpanel="{{ block.id }}" aria-hidden="true" inert>
        <div class="lhx-mobile-subpanel__header">
          <button class="lhx-mobile-subpanel__back" type="button" data-mobile-panel-back aria-label="Back to main menu">{% render 'lhx-icon', icon: 'arrow-left' %}<span>{{ block.settings.label | escape }}</span></button>
          <button class="lhx-icon-button" type="button" data-drawer-close aria-label="Close menu">{% render 'lhx-icon', icon: 'close' %}</button>
        </div>
        <div class="lhx-mobile-subpanel__body">
          <ul class="lhx-mobile-discovery-menu">
            {%- if mobile_navigation != blank -%}
              {%- for link in mobile_navigation.links -%}
                {%- if link.links.size > 0 -%}
                  {%- assign mobile_group_key = block.id | append: '-group-' | append: forloop.index -%}
                  <li class="lhx-mobile-discovery-menu__group">
                    <button class="lhx-mobile-discovery-menu__trigger" type="button" data-mobile-panel-open="{{ mobile_group_key }}" aria-controls="lhx-mobile-panel-{{ mobile_group_key }}" aria-expanded="false"><span>{{ link.title | escape }}</span>{% render 'lhx-icon', icon: 'arrow-right' %}</button>
                  </li>
                {%- else -%}
                  <li><a class="lhx-mobile-discovery-menu__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <li><a class="lhx-mobile-discovery-menu__link" href="{{ mobile_featured_url }}">Top picks</a></li>
              <li><a class="lhx-mobile-discovery-menu__link" href="{{ routes.all_products_collection_url }}?sort_by=best-selling">Best sellers</a></li>
              <li><a class="lhx-mobile-discovery-menu__link" href="{{ mobile_primary_url }}">Trending</a></li>
              <li><a class="lhx-mobile-discovery-menu__link" href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New arrivals</a></li>
              <li><a class="lhx-mobile-discovery-menu__link" href="{{ mobile_on_sale_url }}">On sale</a></li>
              <li class="lhx-mobile-discovery-menu__group"><button class="lhx-mobile-discovery-menu__trigger" type="button" data-mobile-panel-open="{{ block.id }}-activity" aria-controls="lhx-mobile-panel-{{ block.id }}-activity" aria-expanded="false"><span>By activity</span>{% render 'lhx-icon', icon: 'arrow-right' %}</button></li>
              <li class="lhx-mobile-discovery-menu__group"><button class="lhx-mobile-discovery-menu__trigger" type="button" data-mobile-panel-open="{{ block.id }}-feature" aria-controls="lhx-mobile-panel-{{ block.id }}-feature" aria-expanded="false"><span>By feature</span>{% render 'lhx-icon', icon: 'arrow-right' %}</button></li>
            {%- endif -%}
          </ul>
          {%- if mobile_featured_collection != blank and mobile_featured_collection.products_count > 0 -%}
            <div class="lhx-mobile-products">
              <h3 class="lhx-mobile-products__heading">{{ block.settings.mobile_products_heading | default: 'Best deals 🔥' | escape }}</h3>
              <div class="lhx-mobile-products__grid">
                {%- for product in mobile_featured_collection.products limit: 5 -%}
                  {%- liquid
                    assign variant = product.selected_or_first_available_variant
                    assign sale_percent = 0
                    if product.compare_at_price > product.price
                      assign sale_saving = product.compare_at_price | minus: product.price
                      assign sale_percent = sale_saving | times: 100.0 | divided_by: product.compare_at_price | round
                    endif
                  -%}
                  <article class="lhx-mobile-product-card">
                    <div class="lhx-mobile-product-card__media">
                      <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                        {%- if product.featured_image != blank -%}
                          {{ product.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '160,240,320,420', sizes: '(max-width: 990px) calc((100vw - 74px) / 2), 180px', alt: product.title }}
                        {%- endif -%}
                      </a>
                      {%- if sale_percent > 0 -%}<span class="lhx-mobile-product-card__badge">-{{ sale_percent }}%</span>{%- endif -%}
                      {%- if variant != blank and variant.available -%}
                        <button class="lhx-mobile-product-card__add" type="button" data-quick-add data-quick-add-icon data-variant-id="{{ variant.id }}" data-product-title="{{ product.title | escape }}" aria-label="Quick add {{ product.title | escape }}">
                          {% render 'lhx-icon', icon: 'bag' %}<span class="visually-hidden">Quick add {{ product.title | escape }}</span>
                        </button>
                      {%- endif -%}
                    </div>
                    <a class="lhx-mobile-product-card__title" href="{{ product.url }}">{{ product.title | escape }}</a>
                    <div class="lhx-mobile-product-card__price">
                      <span>{{ product.price | money }}</span>
                      {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
                    </div>
                  </article>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </section>
      {%- if mobile_navigation != blank -%}
        {%- for link in mobile_navigation.links -%}
          {%- if link.links.size > 0 -%}
            {%- assign mobile_group_key = block.id | append: '-group-' | append: forloop.index -%}
            <section class="lhx-mobile-subpanel" id="lhx-mobile-panel-{{ mobile_group_key }}" data-mobile-subpanel="{{ mobile_group_key }}" data-mobile-panel-parent="{{ block.id }}" aria-hidden="true" inert>
              <div class="lhx-mobile-subpanel__header">
                <button class="lhx-mobile-subpanel__back" type="button" data-mobile-panel-back="{{ block.id }}" aria-label="Back to {{ block.settings.label | escape }}">{% render 'lhx-icon', icon: 'arrow-left' %}<span>{{ link.title | escape }}</span></button>
                <button class="lhx-icon-button" type="button" data-drawer-close aria-label="Close menu">{% render 'lhx-icon', icon: 'close' %}</button>
              </div>
              <div class="lhx-mobile-subpanel__body">
                <ul>
                  {%- if link.url != blank and link.url != '#' -%}<li><a href="{{ link.url }}">View all {{ link.title | escape }}</a></li>{%- endif -%}
                  {%- for child_link in link.links -%}<li><a href="{{ child_link.url }}">{{ child_link.title | escape }}</a></li>{%- endfor -%}
                </ul>
              </div>
            </section>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <section class="lhx-mobile-subpanel" id="lhx-mobile-panel-{{ block.id }}-activity" data-mobile-subpanel="{{ block.id }}-activity" data-mobile-panel-parent="{{ block.id }}" aria-hidden="true" inert>
          <div class="lhx-mobile-subpanel__header"><button class="lhx-mobile-subpanel__back" type="button" data-mobile-panel-back="{{ block.id }}" aria-label="Back to {{ block.settings.label | escape }}">{% render 'lhx-icon', icon: 'arrow-left' %}<span>By activity</span></button><button class="lhx-icon-button" type="button" data-drawer-close aria-label="Close menu">{% render 'lhx-icon', icon: 'close' %}</button></div>
          <div class="lhx-mobile-subpanel__body"><ul><li><a href="{{ mobile_primary_url }}">Shop {{ block.settings.label | escape }}</a></li>{%- if block.settings.secondary_collection != blank -%}<li><a href="{{ block.settings.secondary_collection.url }}">{{ block.settings.secondary_collection.title | escape }}</a></li>{%- endif -%}</ul></div>
        </section>
        <section class="lhx-mobile-subpanel" id="lhx-mobile-panel-{{ block.id }}-feature" data-mobile-subpanel="{{ block.id }}-feature" data-mobile-panel-parent="{{ block.id }}" aria-hidden="true" inert>
          <div class="lhx-mobile-subpanel__header"><button class="lhx-mobile-subpanel__back" type="button" data-mobile-panel-back="{{ block.id }}" aria-label="Back to {{ block.settings.label | escape }}">{% render 'lhx-icon', icon: 'arrow-left' %}<span>By feature</span></button><button class="lhx-icon-button" type="button" data-drawer-close aria-label="Close menu">{% render 'lhx-icon', icon: 'close' %}</button></div>
          <div class="lhx-mobile-subpanel__body"><ul><li><a href="{{ mobile_featured_url }}">Featured {{ block.settings.label | escape }}</a></li>{%- if block.settings.secondary_collection != blank -%}<li><a href="{{ block.settings.secondary_collection.url }}">{{ block.settings.secondary_collection.title | escape }}</a></li>{%- endif -%}</ul></div>
        </section>
      {%- endif -%}
    {%- endfor -%}
    <section class="lhx-mobile-subpanel" id="lhx-mobile-panel-pages-{{ section.id }}" data-mobile-subpanel="pages" aria-hidden="true" inert>
      <div class="lhx-mobile-subpanel__header">
        <button class="lhx-mobile-subpanel__back" type="button" data-mobile-panel-back aria-label="Back to main menu">{% render 'lhx-icon', icon: 'arrow-left' %}<span>{{ section.settings.pages_label | escape }}</span></button>
        <button class="lhx-icon-button" type="button" data-drawer-close aria-label="Close menu">{% render 'lhx-icon', icon: 'close' %}</button>
      </div>
      <div class="lhx-mobile-subpanel__body"><ul>{%- for block in page_blocks -%}{%- if block.settings.page != blank -%}<li><a href="{{ block.settings.page.url }}">{{ block.settings.label | default: block.settings.page.title | escape }}</a></li>{%- endif -%}{%- endfor -%}</ul></div>
    </section>
  </aside>

  <aside class="lhx-drawer" id="lhx-search-drawer-{{ section.id }}" data-drawer="search" role="dialog" aria-modal="true" aria-label="Search" aria-hidden="true" tabindex="-1" hidden>
    <div class="lhx-drawer__header"><strong>Search</strong><button class="lhx-icon-button" type="button" data-drawer-close aria-label="Close search">{% render 'lhx-icon', icon: 'close' %}</button></div>
    <form class="lhx-search" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="lhx-search-{{ section.id }}">Search</label><input id="lhx-search-{{ section.id }}" name="q" type="search" placeholder="What are you looking for?" autocomplete="off" data-search-input><button type="submit" aria-label="Submit search">{% render 'lhx-icon', icon: 'arrow-right' %}</button></form>
    <div class="lhx-search-results" data-search-results role="status" aria-live="polite" aria-busy="false"></div>
    <div class="lhx-search-popular"><p>Popular searches</p><div>{%- assign popular_terms = section.settings.popular_searches | split: ',' -%}{%- for term in popular_terms -%}<a href="{{ routes.search_url }}?q={{ term | strip | url_encode }}">{{ term | strip | escape }}</a>{%- endfor -%}</div></div>
  </aside>

  <aside class="lhx-drawer" id="lhx-cart-{{ section.id }}" data-drawer="cart" role="dialog" aria-modal="true" aria-label="Cart" aria-hidden="true" tabindex="-1" hidden>
    <div class="lhx-drawer__header"><strong>Cart <span data-cart-drawer-count>({{ cart.item_count }})</span></strong><button class="lhx-icon-button" type="button" data-drawer-close aria-label="Close cart">{% render 'lhx-icon', icon: 'close' %}</button></div>
    <div class="lhx-cart-content" data-cart-content aria-live="polite" aria-busy="false">
      {%- if cart.item_count == 0 -%}<p class="lhx-cart-empty">Your cart is empty.</p><a class="lhx-button" href="{{ routes.all_products_collection_url }}">Continue shopping</a>{%- else -%}{%- for item in cart.items -%}<div class="lhx-cart-line"><a href="{{ item.url }}">{%- if item.image -%}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.product.title }}{%- endif -%}</a><div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><span>{{ item.quantity }} × {{ item.final_price | money }}</span></div></div>{%- endfor -%}<a class="lhx-button" href="{{ routes.cart_url }}">View cart · {{ cart.total_price | money }}</a>{%- endif -%}
    </div>
  </aside>

  <aside class="lhx-drawer" id="lhx-localization-{{ section.id }}" data-drawer="localization" role="dialog" aria-modal="true" aria-label="Localization" aria-hidden="true" tabindex="-1" hidden>
    <div class="lhx-drawer__header"><strong>Country & language</strong><button class="lhx-icon-button" type="button" data-drawer-close aria-label="Close localization">{% render 'lhx-icon', icon: 'close' %}</button></div>
    {% form 'localization', class: 'lhx-localization-form' %}
      <label class="visually-hidden" for="lhx-country-search-{{ section.id }}">Find country</label>
      <div class="lhx-country-search-wrap"><input id="lhx-country-search-{{ section.id }}" class="lhx-country-search" type="search" placeholder="Search" autocomplete="off" data-country-search><span aria-hidden="true">{% render 'lhx-icon', icon: 'search' %}</span></div>
      <select class="visually-hidden" id="lhx-country-{{ section.id }}" name="country_code" data-country-select tabindex="-1" aria-hidden="true">{%- for country in localization.available_countries -%}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>{%- endfor -%}</select>
      <div class="lhx-country-list" data-country-list role="listbox" aria-label="Country">
        {%- for country in localization.available_countries -%}
          <button class="lhx-country-option{% if country.iso_code == localization.country.iso_code %} is-selected{% endif %}" type="button" data-country-option data-country-code="{{ country.iso_code }}" role="option" aria-selected="{% if country.iso_code == localization.country.iso_code %}true{% else %}false{% endif %}"><span class="lhx-country-flag" data-country-flag="{{ country.iso_code }}">{{ country.iso_code }}</span><span class="lhx-country-name">{{ country.name }}</span><span class="lhx-country-currency">{{ country.currency.iso_code }} {{ country.currency.symbol }}</span></button>
        {%- endfor -%}
      </div>
      <div class="lhx-language-controls"><label for="lhx-language-{{ section.id }}">Language</label><select id="lhx-language-{{ section.id }}" name="locale_code">{%- for language in localization.available_languages -%}<option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>{%- endfor -%}</select><button class="lhx-button" type="submit">Apply</button></div>
    {% endform %}
  </aside>

  <nav class="lhx-bottom-dock lhx-mobile-only" aria-label="Quick navigation">
    <a href="{{ routes.root_url }}">{% render 'lhx-icon', icon: 'home' %}<span>Home</span></a><button type="button" data-drawer-open="menu" aria-expanded="false" aria-controls="lhx-menu-{{ section.id }}">{% render 'lhx-icon', icon: 'menu' %}<span>Menu</span></button><button type="button" data-drawer-open="search" aria-expanded="false" aria-controls="lhx-search-drawer-{{ section.id }}">{% render 'lhx-icon', icon: 'search' %}<span>Search</span></button><a href="{{ routes.all_products_collection_url }}">{% render 'lhx-icon', icon: 'arrow-right' %}<span>Shop</span></a><button type="button" data-drawer-open="cart" aria-expanded="false" aria-controls="lhx-cart-{{ section.id }}">{% render 'lhx-icon', icon: 'bag' %}<span>Cart</span></button><a href="{{ routes.account_url }}">{% render 'lhx-icon', icon: 'account' %}<span>Account</span></a>
  </nav>
</header>

{% schema %}
{
  "name": "Editorial header",
  "settings": [
    {"type":"image_picker","id":"logo","label":"Logo image"},
    {"type":"checkbox","id":"enable_sticky","label":"Enable floating desktop header on scroll","default":true},
    {"type":"checkbox","id":"overlay_on_home","label":"Overlay header on homepage hero","default":true},
    {"type":"checkbox","id":"show_announcement","label":"Show announcement bar","default":true},
    {"type":"checkbox","id":"enable_announcement_autoplay","label":"Autoplay announcements","default":true},
    {"type":"range","id":"announcement_delay","min":3,"max":10,"step":1,"unit":"s","label":"Announcement delay","default":5},
    {"type":"text","id":"pages_label","label":"Pages menu label","default":"Pages"},
    {"type":"text","id":"find_link_label","label":"Utility link label","default":"Find your shoes"},
    {"type":"url","id":"find_link","label":"Utility link"},
    {"type":"checkbox","id":"show_localization","label":"Show country and language selector","default":true},
    {"type":"text","id":"popular_searches","label":"Popular search terms (comma separated)","default":"New arrivals, Leather, Classic"},
    {"type":"header","content":"Mobile social links"},
    {"type":"url","id":"social_facebook","label":"Facebook"},
    {"type":"url","id":"social_instagram","label":"Instagram"},
    {"type":"url","id":"social_youtube","label":"YouTube"},
    {"type":"url","id":"social_tiktok","label":"TikTok"}
  ],
  "blocks": [
    {"type":"announcement","name":"Announcement","limit":4,"settings":[{"type":"text","id":"text","label":"Text","default":"Free shipping on orders over $75"},{"type":"url","id":"link","label":"Link"}]},
    {
      "type": "mega_menu",
      "name": "Helix mega menu",
      "limit": 2,
      "settings": [
        {"type":"text","id":"label","label":"Menu label","default":"Shop"},
        {"type":"collection","id":"collection","label":"Main collection"},
        {"type":"link_list","id":"menu","label":"Top links","info":"Uses the Helix Top picks, Best sellers, Trending, New arrivals and On sale links when blank."},
        {"type":"text","id":"secondary_title","label":"Second column heading","default":"By activity"},
        {"type":"link_list","id":"secondary_menu","label":"Activity links","info":"Uses the six Helix activity links when blank."},
        {"type":"text","id":"feature_title","label":"Third column heading","default":"By feature"},
        {"type":"link_list","id":"feature_menu","label":"Feature links","info":"Uses the five Helix feature links when blank."},
        {"type":"collection","id":"secondary_collection","label":"Second collection / banner fallback"},
        {"type":"collection","id":"featured_collection","label":"Featured products collection"},
        {"type":"header","content":"Desktop image banners"},
        {"type":"image_picker","id":"promo_image_1","label":"Banner 1 image"},
        {"type":"text","id":"promo_title_1","label":"Banner 1 title","default":"Women’s sale"},
        {"type":"url","id":"promo_link_1","label":"Banner 1 link"},
        {"type":"image_picker","id":"promo_image_2","label":"Banner 2 image"},
        {"type":"text","id":"promo_title_2","label":"Banner 2 title","default":"Women’s favorites"},
        {"type":"url","id":"promo_link_2","label":"Banner 2 link"},
        {"type":"text","id":"promo_button_label","label":"Banner link label","default":"Shop now"},
        {"type":"header","content":"Desktop product carousel"},
        {"type":"text","id":"desktop_products_heading","label":"Product carousel heading","default":"Best deals 🔥"},
        {"type":"header","content":"Mobile"},
        {"type":"link_list","id":"mobile_menu","label":"Mobile submenu","info":"Top-level links are shown directly. Links with child items open another sliding panel."},
        {"type":"url","id":"mobile_on_sale_link","label":"Mobile On sale link"},
        {"type":"text","id":"mobile_products_heading","label":"Mobile product heading","default":"Best deals 🔥"}
      ]
    },
    {"type":"page_link","name":"Page link","limit":8,"settings":[{"type":"page","id":"page","label":"Page"},{"type":"text","id":"label","label":"Optional label override"}]}
  ]
}
{% endschema %}
