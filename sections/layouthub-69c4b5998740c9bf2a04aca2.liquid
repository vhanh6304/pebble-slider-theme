											</label>
									 	</div>
											<div class="lh-sizeguide-image">
												<ul class="list-swatch-images">
							         		{%- assign values = ""  -%}
													{%- for variant in product.variants -%}
														{%- assign option_value = variant[index] -%}
														{%- assign option_value_downcase = variant[index] | downcase -%}
														{%- if values != ""%}
															{%- assign tmp = values | split: '|' -%}
															{%- if tmp contains option_value_downcase  -%} {%- continue-%}{%- endif -%}
															{%- assign values = values  | append:   '|' | append: option_value_downcase -%}
														{%- else -%}
															{%- assign values =   option_value_downcase -%}
														{%- endif -%}
														<li data-option-index="{{ option_index }}" data-lh-tooltip="{{option_value | escape}}" class="lh-swatch-select lh-tooltip_top lh-swatch-color {% if option_value == variant_slected[index] %} active{% endif %}" data-value="{{option_value | escape}}">
															 
																{% assign index_color = -1 %}
																{% assign color_val = option_value | downcase %}
																{%- for color_setting in color_names -%}
																	{% assign color_downcase = color_setting | downcase %}
																	{%- if color_downcase == color_val -%}
																		{% assign index_color = forloop.index0 %}
																		{%- break -%}
																	{%- endif -%}
																{%- endfor -%}
																{%- if index_color > -1 -%}
																		<span class="lh-color-app" style="background: {{color_values[index_color]}}"></span>
																{%- else -%}
																		<span class="lh-no-color">{{option_value | escape}}</span>
																{%- endif -%}
															 
														</li>
													{%- endfor -%}
												</ul>

											</div>

							    </div>
						{%- endif -%}
					{%- endfor -%}
					{%- endif -%}
				{%- endif%}{%- if product.variants.size >= 1%}
					{%- for option in product.options_with_values -%}
					{%- assign option_index = forloop.index0 -%}
						{%- assign o = option.name | downcase -%}
						{%- if arr_swatch contains option.name or option.name == "Title" and product.options_with_values.size == 1 and option.values contains "Default Title" -%}
							{%- continue -%}
						{%- endif -%}
						{%- assign index = 'option' | append: forloop.index -%}
						<div class="lh-swatch-simple select-{{option.name | handleize }} select-size swatch-index lh-swatch-variations"  data-option-index="{{ option_index }}">
					      <div class="meta">
					         <label title="">{{ option.name }}:
