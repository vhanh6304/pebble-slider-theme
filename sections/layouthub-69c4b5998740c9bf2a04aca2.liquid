									<div class="lh-selected-text"></div>
								      <ul class="list-swatch-items" >
										{%- for value in option.values -%}
											<li class="lh-swatch-select {% if value == variant_slected[index] %} active{% endif %}" data-value="{{value | escape}}"><span  title="{{value | escape}}" >{{ value}}</span></li>
										{%- endfor -%}
								      </ul>
									</div>
								</div>
   							</div>
					{%- endfor -%}
				{%- endif -%} 
	</div>
	 
