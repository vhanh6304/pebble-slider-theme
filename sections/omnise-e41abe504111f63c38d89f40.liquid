{% assign available = variant.available %}
{% assign has_multiple_variants = false %}

{% if variants.size > 1 %}
  {% assign has_multiple_variants = true %}
{% endif %}

{% assign veryLowThreshold = '40' | default: 0 | plus: 0 %}
{% assign lowThreshold = '80' | default: 0 | plus: 0 %}

{% assign is_very_low = false %}
{% assign is_low = false %}
{% assign is_in_stock = false %}
{% assign is_out_of_stock = false %}

{% if available and inventory_quantity > 0 and inventory_quantity <= veryLowThreshold %}
  {% assign is_very_low = true %}
{% endif %}

{% if available and inventory_quantity > veryLowThreshold and inventory_quantity <= lowThreshold %}
  {% assign is_low = true %}
{% endif %}

{% if available and inventory_quantity > lowThreshold %}
  {% assign is_in_stock = true %}
{% endif %}

{% if available == false or inventory_quantity <= 0 %}
  {% assign is_out_of_stock = true %}
{% endif %}

{% capture state_class %}
    {% if is_out_of_stock %}
        omnise-inventory-out
    {% elsif is_very_low %}
        omnise-inventory-critical
    {% elsif is_low %}
        omnise-inventory-low
    {% else %}
        omnise-inventory-in
    {% endif %}
{% endcapture %}
{% assign state_class = state_class | strip %}

{% capture in_stock_label %}
    {{ 'sections.omnise-e41abe504111f63c38d89f40.omnise_mu8ub' | t }}
  {% endcapture %}
{% assign in_stock_label = in_stock_label | strip | default: 'In stock' %}

{% capture low_stock_label %}
    {{ 'sections.omnise-e41abe504111f63c38d89f40.omnise_ttp8yc' | t }}
  {% endcapture %}
{% assign low_stock_label = low_stock_label | strip | default: 'Low stock' %}

{% capture very_low_label %}
    {{ 'sections.omnise-e41abe504111f63c38d89f40.omnise_sg2w6a' | t }}
  {% endcapture %}
{% assign very_low_label = very_low_label | strip | default: 'Very low stock' %}

{% capture sold_out_label %}
    {{ 'sections.omnise-e41abe504111f63c38d89f40.omnise_sg2w6a' | t }}
  {% endcapture %}
{% assign sold_out_label = sold_out_label | strip | default: 'Sold out' %}

{% if has_multiple_variants == false %}
  {% assign in_stock_label = in_stock_label | replace: '{stock}', inventory_quantity %}
  {% assign low_stock_label = low_stock_label | replace: '{stock}', inventory_quantity %}
  {% assign very_low_label = very_low_label | replace: '{stock}', inventory_quantity %}
  {% assign sold_out_label = sold_out_label | replace: '{stock}', inventory_quantity %}
{% endif %}

{% assign base = 100 %}
{% assign percent = inventory_quantity | times: 100.0 | divided_by: base | round %}
{% if percent > 100 %}
  {% assign percent = 100 %}
{% endif %}

